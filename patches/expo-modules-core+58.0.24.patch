 // Generates minimal stub PCH files from an empty header so the IDE's C++ engine
 // doesn't fail during sync. Near-instant unlike the full ExpoHeader.pch.
 // The actual build regenerates proper PCH files via ninja.
+def splitCommandLine = { String command ->
+  def args = []
+  def currentArg = new StringBuilder()
+  boolean inDoubleQuotes = false
+  boolean inSingleQuotes = false
+  boolean isEscaped = false
+
+  for (int i = 0; i < command.length(); i++) {
+    char c = command.charAt(i)
+
+    if (isEscaped) {
+      currentArg.append(c)
+      isEscaped = false
+      continue
+    }
+
+    if (c == '\\' && !inSingleQuotes) {
+      isEscaped = true
+      continue
+    }
+
+    if (c == '"' && !inSingleQuotes) {
+      inDoubleQuotes = !inDoubleQuotes
+      continue
+    }
+
+    if (c == '\'' && !inDoubleQuotes) {
+      inSingleQuotes = !inSingleQuotes
+      continue
+    }
+
+    if (Character.isWhitespace(c) && !inDoubleQuotes && !inSingleQuotes) {
+      if (currentArg.length() > 0) {
+        args.add(currentArg.toString())
+        currentArg.setLength(0)
+      }
+    } else {
+      currentArg.append(c)
+    }
+  }
+
+  if (currentArg.length() > 0) {
+    args.add(currentArg.toString())
+  }
+
+  return args
+}
